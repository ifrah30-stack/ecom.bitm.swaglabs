<?xml version="1.0" encoding="UTF-8"?>

<suite name="Parallel Testing" parallel="tests" thread-count="2">

    <test name="Smoke Tests">
        <classes>
            <class name="com.swaglabs.login.LoginTest"/>
        </classes>
    </test>

    <test name="Functional Tests">
        <classes>
            <class name="com.swaglabs.login.LoginNegativeTest"/>
            <class name="com.swaglabs.product.ProductTest"/>
            <class name="com.swaglabs.checkout.CheckoutTest"/>
        </classes>
    </test>

    <test name="Integration Tests">
        <classes>
            <class name="com.swaglabs.integration.IntegrationTest"/>
        </classes>
    </test>

    <test name="System Tests">
        <classes>
            <class name="com.swaglabs.system.SystemTest"/>
        </classes>
    </test>

</suite>